# Copy this file to backend/.env and fill in the real values.
# backend/.env is in .gitignore — never commit secrets.

# --- App environment ---
ASPNETCORE_ENVIRONMENT=Development

# --- PostgreSQL ---
POSTGRES_DB=goldsignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API ports ---
API_PORT=5010
DASHBOARD_PORT=5020

# --- Anthropic (Claude) ---
# Generate at https://console.anthropic.com -> API Keys.
# Keys start with sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=512

# --- Telegram (used for signal alerts elsewhere) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
