@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

<PageTitle>GoldSignal — Dashboard</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4" Style="color: #FFD700;">
    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Class="mr-2" />XAUUSD AI Signals
</MudText>

@if (loading)
{
    <MudProgressLinear Color="Color.Warning" Indeterminate="true" Class="mb-4" />
}
else if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@* Stats row *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="2">
        <MudCard Elevation="3" Style="background:#1E1E1E;">
            <MudCardContent Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">Total</MudText>
                <MudText Typo="Typo.h5" Style="color:#FFD700;">@(signals?.Count ?? 0)</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <MudCard Elevation="3" Style="background:#1E1E1E;">
            <MudCardContent Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">Approved</MudText>
                <MudText Typo="Typo.h5" Style="color:#4CAF50;">@ApprovedCount</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <MudCard Elevation="3" Style="background:#1E1E1E;">
            <MudCardContent Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">Rejected</MudText>
                <MudText Typo="Typo.h5" Style="color:#F44336;">@RejectedCount</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <MudCard Elevation="3" Style="background:#1E1E1E;">
            <MudCardContent Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">Approval Rate</MudText>
                <MudText Typo="Typo.h5" Style="color:#FFD700;">@ApprovalRate.ToString("F1")%</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <MudCard Elevation="3" Style="background:#1E1E1E;">
            <MudCardContent Class="pa-3 text-center">
                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">Avg AI Score</MudText>
                <MudText Typo="Typo.h5" Style="color:#FFD700;">@AverageAiScore.ToString("F1")</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="2" Class="d-flex align-center justify-center">
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadSignalsAsync" Disabled="loading">
            Refresh
        </MudButton>
    </MudItem>
</MudGrid>

@* Signals table *@
<MudTable Items="signals ?? new()" Dense="true" Hover="true" Striped="false" Elevation="3"
          Style="background:#1E1E1E;" FixedHeader="true" Height="600px">
    <HeaderContent>
        <MudTh>Time UTC</MudTh>
        <MudTh>Symbol</MudTh>
        <MudTh>Action</MudTh>
        <MudTh>Entry</MudTh>
        <MudTh>SL</MudTh>
        <MudTh>TP</MudTh>
        <MudTh>Algo</MudTh>
        <MudTh>AI</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Spread</MudTh>
        <MudTh>ATR</MudTh>
        <MudTh>Session</MudTh>
        <MudTh>AI Comment</MudTh>
        <MudTh>Reason</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Time UTC">@context.CreatedAtUtc.ToString("MM-dd HH:mm")</MudTd>
        <MudTd DataLabel="Symbol">@context.Symbol</MudTd>
        <MudTd DataLabel="Action">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                     Color="@(context.Action.Equals("BUY", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Error)">
                @context.Action
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Entry">@context.Entry.ToString("F2")</MudTd>
        <MudTd DataLabel="SL">@context.StopLoss.ToString("F2")</MudTd>
        <MudTd DataLabel="TP">@context.TakeProfit.ToString("F2")</MudTd>
        <MudTd DataLabel="Algo">@context.AlgoScore.ToString("F0")</MudTd>
        <MudTd DataLabel="AI">@context.AiScore.ToString("F0")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                     Color="@(context.Approved ? Color.Success : Color.Error)">
                @(context.Approved ? "✓ OK" : "✗ KO")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Spread">@context.Spread.ToString("F1")</MudTd>
        <MudTd DataLabel="ATR">@context.Atr.ToString("F1")</MudTd>
        <MudTd DataLabel="Session">@context.Session</MudTd>
        <MudTd DataLabel="AI Comment" Style="max-width:250px;white-space:normal;">@context.AiComment</MudTd>
        <MudTd DataLabel="Reason" Style="max-width:200px;white-space:normal;">@context.Reason</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4" Style="color:rgba(255,255,255,0.4);">No signals recorded yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<SignalDto>? signals;
    private bool loading = true;
    private string? errorMessage;
    private HubConnection? hubConnection;

    private int ApprovedCount => signals?.Count(x => x.Approved) ?? 0;
    private int RejectedCount => (signals?.Count ?? 0) - ApprovedCount;
    private double ApprovalRate => signals is { Count: > 0 } ? ApprovedCount * 100.0 / signals.Count : 0.0;
    private double AverageAiScore => signals is { Count: > 0 } ? signals.Average(x => x.AiScore) : 0.0;

    protected override async Task OnInitializedAsync()
    {
        await LoadSignalsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var apiBase = Configuration["ApiBaseUrl"] ?? "http://localhost:5010";
        var hubUrl = $"{apiBase.TrimEnd('/')}/hubs/signals";

        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<SignalDto>("signal-received", signal =>
        {
            signals ??= new List<SignalDto>();
            signals.Insert(0, signal);
            if (signals.Count > 200) signals.RemoveAt(signals.Count - 1);
            InvokeAsync(StateHasChanged);
        });

        try { await hubConnection.StartAsync(); }
        catch { /* SignalR failure is non-fatal — polling still works */ }
    }

    private async Task LoadSignalsAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("api");
            signals = await client.GetFromJsonAsync<List<SignalDto>>("/api/signals/recent?take=100");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
